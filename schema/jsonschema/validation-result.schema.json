{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oakrtb/openrtb/schema/jsonschema/validation-result.schema.json",
  "title": "OakRTB ValidationResult",
  "description": "Unified validation outcome for BidRequest / BidResponse checks. Use as HTTP 400 body when validation fails.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "errors"],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "true when the payload passed all checks"
    },
    "errors": {
      "type": "array",
      "description": "Empty when ok is true",
      "items": {
        "$ref": "#/$defs/ValidationError"
      }
    }
  },
  "$defs": {
    "ValidationError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error class",
          "enum": ["required", "type", "format", "parse", "native", "constraint"]
        },
        "path": {
          "type": "string",
          "description": "JSON Pointer (RFC 6901) to the failing location; empty string for whole document"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable explanation"
        }
      }
    }
  },
  "examples": [
    {
      "ok": true,
      "errors": []
    },
    {
      "ok": false,
      "errors": [
        {
          "code": "required",
          "path": "/imp",
          "message": "'imp' is a required property"
        }
      ]
    }
  ]
}
